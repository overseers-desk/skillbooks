#!/usr/bin/env bash
# Headless DOM dump against the user's logged-in Chromium session.
# Strategy and decisions (why Chromium, why the live user-data-dir, etc.): ../BROWSER.md.
#
# Usage:   not-google-chrome [-t SECONDS] [--pdf PATH] URL [extra-flag ...]
# Output:  rendered DOM on stdout (default), or PDF written to PATH (--pdf).
#          Redirect stdout to a file: dumps are commonly several MB and flood
#          caller context if returned directly. Default timeout 15s. Pass
#          extra Chrome-compatible flags after the URL (e.g. --virtual-time-budget=N,
#          --log-net-log=PATH); they go through to the underlying invocation.
# Exit 64: bad usage. Exit 77: URL on the abuse list (override with
#          --yes-i-am-not-stupid). Exit 78: unsupported OS, missing dependency,
#          or [browser] user_agent missing from config.ini.
#
# macOS prerequisite: brew install util-linux coreutils (flock, gtimeout).
# Linux has both natively.
#
# What this wrapper produces, by platform:
#   Linux (snap Chromium):
#     flock /tmp/chromium.lock timeout 15 chromium \
#       --user-data-dir="$HOME/snap/chromium/common/chromium" \
#       --headless=new --dump-dom --window-size=3840,2160 --user-agent="..." URL
#     (non-snap: --user-data-dir="$HOME/.config/chromium". Snap is detected
#     via `readlink -f $(which chromium)` resolving to /usr/bin/snap.)
#   macOS (Chromium installed via Homebrew cask):
#     /opt/homebrew/opt/util-linux/bin/flock /tmp/chromium.lock gtimeout 15 \
#       "/Applications/Chromium.app/Contents/MacOS/Chromium" \
#       --user-data-dir="$HOME/Library/Application Support/Chromium" \
#       --headless=new --dump-dom --window-size=3840,2160 --user-agent="..." URL
#
# Conventions:
#   - --headless=new, not legacy --headless.
#   - Do not set --virtual-time-budget for general use; a few skills
#     (instagram, facebook) pass it explicitly because their JS-rendered
#     endpoints need a budget.
#   - UA override is required, read from [browser] user_agent in
#     $HOME/.claude/skills/config.ini (the same file and section the CDP
#     skills read; the wrapper exits 78 if it is missing). It defeats sites
#     that block on the literal string HeadlessChrome, and keeps the fetch
#     fingerprint matching the user's logged-in browser session.
#
# When to call this wrapper vs WebFetch:
#   Prefer WebFetch when the site allows it (converts HTML to plain text
#   before loading into context, far smaller than a raw DOM dump). Fall
#   back to this wrapper only when bot detection blocks WebFetch.

set -euo pipefail

# Abuse list. URLs containing any of these substrings are refused unless
# --yes-i-am-not-stupid is passed. The wrapper exists for sites that block
# automated access (Akamai, Cloudflare, login walls). For these patterns,
# WebFetch or curl is cheaper, faster, and does not lock the user's user-data-dir.
# Edit this list when a new common-abuse case shows up; a tighter pattern
# beats a looser one (prefer "www.google." over "google" so we do not catch
# a randomly-named google-something on a legitimate target site).
ABUSE_PATTERNS=(
  "google.com"
  "www.google."
  "wikipedia.org"
  "github.com"
  "raw.githubusercontent.com"
  "news.ycombinator.com"
  "stackoverflow.com"
  "arxiv.org"
  "archive.org"
)

timeout=15
mode_args=(--dump-dom)
print_args=0
override=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -t)                     timeout="$2"; shift 2 ;;
    --pdf)                  mode_args=(--no-pdf-header-footer "--print-to-pdf=$2"); shift 2 ;;
    --print-args)           print_args=1; shift ;;
    --yes-i-am-not-stupid)  override=1; shift ;;
    *)                      break ;;
  esac
done

if [[ $print_args -eq 0 && $# -lt 1 ]]; then
  echo "Usage: not-google-chrome [-t SECONDS] [--pdf PATH] [--print-args] [--yes-i-am-not-stupid] URL [extra-flag ...]" >&2
  exit 64
fi

url="${1:-}"
[[ $print_args -eq 0 ]] && shift

if [[ $print_args -eq 0 && $override -eq 0 ]]; then
  for pat in "${ABUSE_PATTERNS[@]}"; do
    if [[ "$url" == *"$pat"* ]]; then
      cat >&2 <<EOF
not-google-chrome: refusing to fetch $url

This wrapper exists for sites that block automated access (Akamai,
Cloudflare, login walls). The URL matches abuse pattern '$pat', a site
that ordinarily responds to WebFetch or curl. Using a logged-in browser
session here is wasteful: it locks the user's user-data-dir, takes seconds
instead of milliseconds, and leaks attribution from their identity into a
fetch that did not need it.

Try WebFetch first; for raw bytes, try curl. If you genuinely need a
logged-in browser session against this URL (rare), re-run with
--yes-i-am-not-stupid.
EOF
      exit 77
    fi
  done
fi

case "$(uname)" in
  Linux)
    binary=chromium
    flock_cmd=flock
    timeout_cmd=timeout
    if [[ "$(readlink -f "$(command -v chromium 2>/dev/null || echo /missing)")" == /usr/bin/snap ]]; then
      user_data_dir="$HOME/snap/chromium/common/chromium"
    else
      user_data_dir="$HOME/.config/chromium"
    fi
    user_data_dir_args=(--user-data-dir="$user_data_dir")
    ;;
  Darwin)
    binary='/Applications/Chromium.app/Contents/MacOS/Chromium'
    timeout_cmd=gtimeout
    if   [[ -x /opt/homebrew/opt/util-linux/bin/flock ]]; then flock_cmd=/opt/homebrew/opt/util-linux/bin/flock
    elif [[ -x /usr/local/opt/util-linux/bin/flock   ]]; then flock_cmd=/usr/local/opt/util-linux/bin/flock
    else
      echo "not-google-chrome: flock not found; run 'brew install util-linux'" >&2
      exit 78
    fi
    user_data_dir_args=(--user-data-dir="$HOME/Library/Application Support/Chromium")
    ;;
  *)
    echo "not-google-chrome: unsupported OS $(uname)" >&2
    exit 78
    ;;
esac

if [[ $print_args -eq 1 ]]; then
  # Output binary + user-data-dir args as JSON for CDP scripts to consume.
  # The args are emitted as a JSON array; each element is one flag string.
  user_data_dir_json="["
  first=1
  for arg in "${user_data_dir_args[@]}"; do
    [[ $first -eq 0 ]] && user_data_dir_json+=","
    user_data_dir_json+="\"$(echo "$arg" | sed 's/"/\\"/g')\""
    first=0
  done
  user_data_dir_json+="]"
  printf '{"binary":"%s","user_data_dir_args":%s}\n' \
    "$(echo "$binary" | sed 's/"/\\"/g')" "$user_data_dir_json"
  exit 0
fi

# UA comes from [browser] user_agent in config.ini so the headless fetch
# presents the same fingerprint as the browser the user logs in with, read from
# the same file and section the CDP skills (e.g. linkedin.com) read. No default:
# a wrong UA silently diverging from the logged-in session is worse than a hard
# failure.
config="$HOME/.claude/skills/config.ini"
if [[ ! -f "$config" ]]; then
  echo "not-google-chrome: $config not found. Copy config.ini.example to config.ini and fill the [browser] section." >&2
  exit 78
fi
ua="$(awk '
  /^[[:space:]]*\[/ { gsub(/[][[:space:]]/, ""); sect=$0; next }
  sect=="browser" && /^[[:space:]]*user_agent[[:space:]]*=/ {
    sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit
  }
' "$config")"
if [[ -z "$ua" ]]; then
  cat >&2 <<EOF
not-google-chrome: [browser] user_agent missing from $config.

Set it to the exact User-Agent of the browser you log into sites with, so the
headless fetch matches your authenticated session. Capture it from a real
request in the DevTools Network panel. See config.ini.example.
EOF
  exit 78
fi
if [[ "$ua" == *HeadlessChrome* ]]; then
  echo "not-google-chrome: user_agent in $config contains 'HeadlessChrome', the marker sites block on. Use the UA of a real browser." >&2
  exit 78
fi
common=(--headless=new "${mode_args[@]}" --window-size=3840,2160 --user-agent="$ua")

exec "$flock_cmd" /tmp/chromium.lock "$timeout_cmd" "$timeout" \
  "$binary" "${user_data_dir_args[@]}" "${common[@]}" "$@" "$url"
