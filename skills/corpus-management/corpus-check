#!/usr/bin/env python3
"""corpus-check - list every corpus/ folder under ROOT and flag what breaks the layout.

Usage:
  corpus-check [ROOT]

One line per corpus/ folder: its path, archive count, growth (generations, or
snapshot once one exists), whether the archives are tracked, ignored or
untracked in git, and the flags: loose files beside the archives, an archive
with no fetch log, a .gitignore not listing raw/, extracted/ and staging/,
files left in staging/. Exits 1 when anything is flagged. ROOT defaults to the
current folder; the walk stays on one file system and skips .git.
"""
import os
import re
import subprocess
import sys

ARCHIVE = re.compile(r"^(.+)-(pages|snapshot)\.tar\.zst$")
LOG = re.compile(r"^(.+)-fetch-log\.tsv$")
FOLDERS = {"raw", "extracted", "staging"}
IGNORED = ["raw/", "extracted/", "staging/"]


def git_state(folder, names):
    if not names:
        return "-"
    def run(*cmd):
        r = subprocess.run(["git", "-C", folder, *cmd, "--", *names], capture_output=True, text=True)
        return r.returncode, set(r.stdout.split())
    code, tracked = run("ls-files")
    if code:
        return "no git"
    _, ignored = run("check-ignore", "--no-index")
    states = {"tracked" if n in tracked else "ignored" if n in ignored else "untracked" for n in names}
    return states.pop() if len(states) == 1 else "mixed"


def check(folder):
    entries = sorted(os.listdir(folder))
    archives = [n for n in entries if ARCHIVE.match(n)]
    logs = {LOG.match(n).group(1) for n in entries if LOG.match(n)}
    flags = []
    loose = [n for n in entries if n not in archives and not LOG.match(n) and n != ".gitignore"
             and not (n in FOLDERS and os.path.isdir(os.path.join(folder, n)))]
    if loose:
        flags.append(f"{len(loose)} loose ({', '.join(loose[:3])}{', ...' if len(loose) > 3 else ''})")
    unlogged = [n for n in archives if ARCHIVE.match(n).group(1) not in logs]
    if unlogged:
        flags.append(f"no fetch log for {', '.join(unlogged)}")
    ignore = os.path.join(folder, ".gitignore")
    have = open(ignore).read().split() if os.path.exists(ignore) else []
    missing = [p for p in IGNORED if p not in have]
    if missing:
        flags.append(f".gitignore lacks {' '.join(missing)}")
    staged = sum(len(f) for _, _, f in os.walk(os.path.join(folder, "staging")))
    if staged:
        flags.append(f"{staged} files in staging/, not yet added")
    growth = "snapshot" if any(ARCHIVE.match(n).group(2) == "snapshot" for n in archives) else "generations" if archives else "-"
    return [folder, f"{len(archives)} archives", growth, git_state(folder, archives), "; ".join(flags) or "ok"], bool(flags)


def main():
    root = sys.argv[1] if len(sys.argv) > 1 else "."
    if len(sys.argv) > 2 or root.startswith("-"):
        sys.exit(__doc__.split("\n\n")[1])
    dev = os.stat(root).st_dev
    bad = False
    for top, dirs, _ in os.walk(root):
        dirs[:] = sorted(d for d in dirs if d != ".git" and os.stat(os.path.join(top, d)).st_dev == dev)
        if "corpus" in dirs:
            dirs.remove("corpus")
            line, flagged = check(os.path.join(top, "corpus"))
            bad |= flagged
            print("\t".join(line))
    sys.exit(1 if bad else 0)


if __name__ == "__main__":
    main()
