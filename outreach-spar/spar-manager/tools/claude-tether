#!/bin/sh
# claude-tether - run claude so that it dies with the dispatcher (#202).
#   SPAR_TETHER_PID=<dispatcher pid> SPAR_TETHER_CLAUDE=<claude path> \
#       claude-tether <claude args...>
# deadman runs this under setsid as the lead of the session's group. A
# watcher there sees the dispatcher (the parent) die, logs it and TERMs
# the group, KILL after a grace; without setsid, only the claude pid.

lead=$$
if [ -z "$SPAR_TETHER_PID" ] || [ -z "$SPAR_TETHER_CLAUDE" ]; then
    echo "claude-tether: SPAR_TETHER_PID and SPAR_TETHER_CLAUDE must be set" >&2
    exit 127
fi
parent=$(ps -o ppid= -p "$lead" 2>/dev/null | tr -d ' ')
if [ "$parent" != "$SPAR_TETHER_PID" ]; then
    echo "claude-tether: parent is pid $parent, not dispatcher pid $SPAR_TETHER_PID; running untethered" >&2
    exec "$SPAR_TETHER_CLAUDE" "$@"
fi

(
    # Holding the stdout pipe would keep the dispatcher from seeing EOF.
    exec >/dev/null </dev/null
    while :; do
        sleep 2
        parent=$(ps -o ppid= -p "$lead" 2>/dev/null | tr -d ' ')
        [ -z "$parent" ] && exit 0
        [ "$parent" = "$SPAR_TETHER_PID" ] || break
    done
    # The group TERM reaches this shell too; it must outlive it to escalate.
    trap '' TERM
    echo "spar tether: $(date '+%Y-%m-%dT%H:%M:%S%z') dispatcher pid $SPAR_TETHER_PID ended with this session in flight; terminating claude pid $lead" >&2
    kill -s TERM -- "-$lead" 2>/dev/null || kill -s TERM "$lead" 2>/dev/null
    sleep 10
    kill -s KILL -- "-$lead" 2>/dev/null || kill -s KILL "$lead" 2>/dev/null
) &

exec "$SPAR_TETHER_CLAUDE" "$@"
