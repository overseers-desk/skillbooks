<footer>{n_seg} of {len(events)} entries carry an estimate for a segment rather than a bare headcount. Every estimate is a range whose width carries its confidence, with the reasoning recorded beside it. Facts come from the event cache; stars, shortlisting and participation come from the rated list.</footer>
</div>
<script>
const evs=[...document.querySelectorAll('.ev')],dls=[...document.querySelectorAll('tr.dl')],cnt=document.getElementById('count');
let country='',minStars=0,lens='all',shortOnly=false;
function apply(){{
 let n=0;
 evs.forEach(e=>{{
  const ok=(!country||e.dataset.country===country)
        &&(+e.dataset.stars>=minStars)
        &&(!shortOnly||e.dataset.short==='1')
        &&(lens==='all'||e.dataset.lens.split(' ').includes(lens));
  e.classList.toggle('hide',!ok); if(ok)n++;
 }});
 dls.forEach(r=>{{
  r.classList.toggle('hide',(shortOnly&&r.dataset.short!=='1')||(+r.dataset.stars<minStars));
 }});
 document.querySelectorAll('.month').forEach(m=>{{
  m.style.display=[...m.querySelectorAll('.ev')].some(e=>!e.classList.contains('hide'))?'':'none';
 }});
 cnt.textContent=n+' shown';
}}
document.getElementById('fc').addEventListener('change',e=>{{country=e.target.value;apply();}});
document.getElementById('fs').addEventListener('click',e=>{{
 shortOnly=!shortOnly; e.target.setAttribute('aria-pressed',String(shortOnly)); apply();
}});
document.querySelectorAll('button[data-s]').forEach(b=>b.addEventListener('click',()=>{{
 document.querySelectorAll('button[data-s]').forEach(x=>x.setAttribute('aria-pressed','false'));
 b.setAttribute('aria-pressed','true'); minStars=+b.dataset.s; apply();
}}));
document.querySelectorAll('button[data-l]').forEach(b=>b.addEventListener('click',()=>{{
 document.querySelectorAll('button[data-l]').forEach(x=>x.setAttribute('aria-pressed','false'));
 b.setAttribute('aria-pressed','true'); lens=b.dataset.l; apply();
}}));
apply();
</script>'''

    os.makedirs(os.path.dirname(os.path.abspath(out)) or ".", exist_ok=True)
    with open(out, "w") as f:
        f.write(page)
    print(f"wrote {out}: {len(events)} events, {n_short} shortlisted, "
          f"{n_seg} with a segment estimate, scale {lo}-{hi}")


if __name__ == "__main__":
    main()
